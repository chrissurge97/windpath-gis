{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Total experience points"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Current level"
    },
    "completed_modules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of completed module IDs"
    },
    "completed_quizzes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of completed quiz IDs"
    },
    "badges": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Earned badge IDs"
    },
    "quiz_scores": {
      "type": "object",
      "description": "Map of quiz ID to score"
    },
    "current_module": {
      "type": "string",
      "default": "gis_basics",
      "description": "Currently active module ID"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}