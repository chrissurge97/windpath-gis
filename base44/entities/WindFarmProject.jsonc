{
  "name": "WindFarmProject",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name"
    },
    "description": {
      "type": "string",
      "description": "Full project JSON blob (layers, turbineTypes, cableTypes, windParams, globalRadii)"
    },
    "folder": {
      "type": "string",
      "description": "Folder path, e.g. 'My Projects/Ireland' or empty for root",
      "default": ""
    },
    "is_training": {
      "type": "boolean",
      "description": "True if this project was auto-created by a training module",
      "default": false
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}